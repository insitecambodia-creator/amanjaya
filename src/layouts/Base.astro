---
import '@fontsource-variable/montserrat/wght.css';
import '../styles/global.css';
import { site } from '../config/site';
import PromoPopup from '../components/promo/PromoPopup.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Design preview: excluded from search until launch (also see public/robots.txt and public/_headers). -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- og:image is added once the hero photograph is in place and a final origin is chosen. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <PromoPopup />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
