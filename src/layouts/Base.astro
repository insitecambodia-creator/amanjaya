---
import '@fontsource-variable/montserrat/wght.css';
import '../styles/global.css';
import { site } from '../config/site';
import PromoPopup from '../components/promo/PromoPopup.astro';
import { getImage } from 'astro:assets';
import socialCover from '../assets/photos/unused/social-cover.png';

interface Props {
  title?: string;
  description?: string;
  /** Structured data (schema.org JSON-LD) for this page, if any. */
  jsonLd?: Record<string, unknown>;
}
const { title = site.title, description = site.description, jsonLd } = Astro.props;

// Canonical and social URLs are absolute, built from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
// The hotel's own 16:9 cover photograph, resized to the 1200x630 size social networks expect.
const ogImage = await getImage({ src: socialCover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Design preview: excluded from search until launch (also see public/robots.txt and public/_headers). -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height ?? 630)} />
    <meta property="og:image:alt" content="A couple walking in front of the Amanjaya Pancam hotel on the Phnom Penh riverside" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <PromoPopup />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
