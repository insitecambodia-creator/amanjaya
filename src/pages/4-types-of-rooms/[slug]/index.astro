---
/**
 * The shared accommodation page. One entry in src/content/rooms.ts gives one page, at the same path the existing
 * WordPress site uses (/4-types-of-rooms/<slug>/), so the URLs carry over.
 * Order: photographs, then the room information (about 65% description, 35% price and booking), then amenities.
 */
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import RoomGallery from '../../../components/rooms/RoomGallery.astro';
import RoomOverview from '../../../components/rooms/RoomOverview.astro';
import RoomAmenities from '../../../components/rooms/RoomAmenities.astro';
import { publishedRooms, type Room } from '../../../content/rooms';

export function getStaticPaths() {
  return publishedRooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

const { room } = Astro.props as { room: Room };
---

<Base title={room.seoTitle} description={room.seoDescription}>
  <SiteHeader home="/" />
  <main id="main">
    <RoomGallery roomName={room.name} photos={room.photos} />
    <RoomOverview room={room} allRoomsHref="/#suites" />
    <RoomAmenities intro={room.amenitiesIntro} items={room.amenities} />
  </main>
  <SiteFooter />
</Base>
