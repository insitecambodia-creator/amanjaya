---
/**
 * Title, spec line and description (about 65% of the width on desktop) beside the price and booking (about 35%).
 * On phones they stack in reading order. Content comes from src/content/rooms.ts.
 */
import RoomBookingPanel from './RoomBookingPanel.astro';
import type { Room } from '../../content/rooms';

interface Props {
  room: Room;
  /** Where "All accommodation" leads: the room categories on the homepage. */
  allRoomsHref: string;
}
const { room, allRoomsHref } = Astro.props;
---

<section class="overview section" aria-labelledby="room-title">
  <div class="container overview__grid">
    <div class="overview__main" data-reveal>
      <a class="overview__back" href={allRoomsHref}>All accommodation</a>
      <h1 id="room-title">{room.name}</h1>

      <ul class="features">
        {room.features.map((f) => <li>{f}</li>)}
      </ul>

      <div class="overview__text">
        {room.description.map((p) => <p class="copy">{p}</p>)}
      </div>
    </div>

    <div class="overview__side" data-reveal>
      <RoomBookingPanel room={room} />
    </div>
  </div>
</section>

<style>
  .overview {
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .overview__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .overview__back {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding-bottom: 0.1rem;
    border-bottom: 1px solid var(--bronze);
    color: var(--bronze-deep);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .overview__back:hover {
    color: var(--teak);
    border-color: var(--teak);
  }

  /* The room title: Instrument Serif Regular, 36 to 40px. */
  h1 {
    max-width: none;
    color: var(--teak);
    font-family: var(--font-display);
    font-size: var(--display-1);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  /* The spec line: plain type with space between the items, no dividers. */
  .features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-family: var(--font-text);
    font-size: var(--step-0);
  }

  .overview__text {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (min-width: 40rem) {
    .features {
      column-gap: 2rem;
    }
  }

  /* Desktop: about 65% for the description and features, 35% for the price and booking. */
  @media (min-width: 56rem) {
    .overview__grid {
      grid-template-columns: minmax(0, 13fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    /* Level with the title's first line rather than the "All accommodation" link above it. */
    .overview__side {
      padding-top: 3.1rem;
    }
  }
</style>
