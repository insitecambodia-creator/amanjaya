---
/**
 * The room's photographs: one large photograph with up to three smaller ones stacked beside it (desktop), or one
 * large photograph followed by a row of small ones (phones). The first photograph is the large one; the next
 * three are the stack, top to bottom. Plain rectangles: no borders, rounded corners or shadows.
 * A missing file shows a labelled placeholder (nothing is hotlinked; see docs/ROOM-TEMPLATE.md).
 */
import Photo from '../Photo.astro';
import type { RoomPhoto } from '../../content/rooms';

interface Props {
  roomName: string;
  photos: RoomPhoto[];
}
const { roomName, photos } = Astro.props;
const [main, ...rest] = photos;
const side = rest.slice(0, 3);
---

{
  main && (
    <section class="gallery" aria-label={`Photographs of the ${roomName}`}>
      <div class="container gallery__frame">
        <div class:list={['gallery__grid', { 'gallery__grid--single': side.length === 0 }]}>
          {/* The large photograph is the first thing seen, so it loads at once and is not faded in. */}
          <div class="gallery__main">
            <Photo
              name={main.key}
              alt={main.alt}
              position={main.position}
              ratio="16 / 9"
              sizes="(min-width: 90rem) 1030px, (min-width: 40rem) 77vw, 135vw"
              widths={[640, 960, 1280, 1600, 2048]}
              loading="eager"
              fetchpriority="high"
              tone="dark"
              label={`${roomName}, main photograph`}
            />
          </div>

          {side.length > 0 && (
            <ul class="gallery__side">
              {side.map((p) => (
                <li data-reveal>
                  <Photo
                    name={p.key}
                    alt={p.alt}
                    position={p.position}
                    sizes="(min-width: 40rem) 23vw, 34vw"
                    widths={[320, 480, 640, 800]}
                    label={`${roomName}, photograph`}
                  />
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  /* One gap size, used both across and down. Phones: the photographs run edge to edge. */
  .gallery {
    --gap: clamp(0.4rem, 1.4vw, 1.2rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .gallery__frame {
    padding-inline: 0;
  }

  .gallery__grid {
    display: grid;
    gap: var(--gap);
  }

  /* Phones: the large photograph is a little taller than 16:9 (the crop is set per photograph in rooms.ts). */
  .gallery__main :global(.photo) {
    aspect-ratio: 4 / 3 !important;
  }

  .gallery__side {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__side :global(.photo) {
    aspect-ratio: 4 / 3;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The same quiet settle as the homepage photograph. */
    .gallery__main :global(.photo > img),
    .gallery__main :global(.photo__placeholder) {
      animation: gallery-settle 2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes gallery-settle {
      from {
        transform: scale(1.04);
      }
      to {
        transform: scale(1);
      }
    }
  }

  /* From 40rem the gallery sits within the page margins, which also keeps the photographs from being enlarged
     past their own width on wide screens. */
  @media (min-width: 40rem) {
    .gallery {
      padding-top: clamp(0.75rem, 1.4vw, 1.25rem);
    }

    .gallery__frame {
      padding-inline: var(--gutter);
    }
  }

  /* Tablet and up: the large photograph on the left (about 77%), the others stacked on the right (about 23%).
     The stack takes the large photograph's height exactly, so the top and bottom edges align. */
  @media (min-width: 48rem) {
    .gallery__grid:not(.gallery__grid--single) {
      grid-template-columns: minmax(0, 3.35fr) minmax(0, 1fr);
    }

    .gallery__main :global(.photo) {
      aspect-ratio: 16 / 9 !important;
    }

    .gallery__side {
      grid-template-columns: none;
      grid-template-rows: repeat(3, minmax(0, 1fr));
      min-height: 0;
    }

    .gallery__side > li {
      position: relative;
      min-height: 0;
    }

    /* Filled into the row by the grid, not sized by the photograph, so the stack cannot change the height. */
    .gallery__side :global(.photo) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      height: 100%;
    }
  }
</style>
