---
/** The amenities list. Plain text, hairline-separated: nothing here that the hotel's own page does not list. */
interface Props {
  intro: string;
  items: string[];
}
const { intro, items } = Astro.props;
---

<section class="amenities section" aria-labelledby="amenities-title">
  <div class="container">
    <div class="amenities__grid">
      <div class="amenities__intro" data-reveal>
        <h2 id="amenities-title">Amenities</h2>
        <p>{intro}</p>
      </div>

      <ul class="amenities__list" data-reveal>
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .amenities {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .amenities__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .amenities__intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .amenities__intro h2 {
    color: var(--teak);
  }

  .amenities__intro p {
    max-width: 38ch;
    color: var(--grey-text);
  }

  .amenities__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .amenities__list li {
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-0);
  }

  @media (min-width: 40rem) {
    .amenities__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 56rem) {
    .amenities__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 7vw, 6rem);
    }
  }
</style>
