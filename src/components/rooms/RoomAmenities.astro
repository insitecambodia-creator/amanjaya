---
/**
 * The amenities: a quiet grid of small line icons with a label beneath each, centred. Shared by every room page, so
 * the icon system lives here: each amenity's icon is chosen by name in ./amenity-icons.ts (Lucide artwork as plain
 * SVG, no library, no JavaScript). The icons are decorative; the label is what is read out. Only the amenities the
 * hotel's own page lists are shown, and there is no booking button here: the room page has one above.
 */
import { amenityIcon } from './amenity-icons';

interface Props {
  intro: string;
  items: string[];
}
const { intro, items } = Astro.props;
---

<section class="amenities section" aria-labelledby="amenities-title">
  <div class="container">
    <div class="amenities__grid">
      <div class="amenities__intro" data-reveal>
        <h2 id="amenities-title">Amenities</h2>
        <p>{intro}</p>
      </div>

      <ul class="amenities__list" data-reveal>
        {
          items.map((item) => (
            <li class="amenity">
              <svg
                class="amenity__icon"
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={amenityIcon(item)}
              />
              <span class="amenity__label">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .amenities {
    padding-block: 0 clamp(3rem, 7vw, 5rem);
  }

  .amenities__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .amenities__intro {
    display: grid;
    gap: 1rem;
    max-width: 52ch;
  }

  .amenities__intro h2 {
    color: var(--teak);
  }

  .amenities__intro p {
    color: var(--grey-text);
  }

  /* A centred, wrapping row of equal cells, so a short last row stays centred under the rows above it: six across
     on desktop (11 amenities make 6 + 5), four on tablets, two on phones. */
  .amenities__list {
    --cols: 2;
    --gap-x: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.75rem, 4vw, 2.5rem) var(--gap-x);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .amenity {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols));
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.65rem;
    min-width: 0;
    text-align: center;
  }

  /* Muted charcoal grey: the text grey (6.7:1 on white, well above the 3:1 asked of graphics). */
  .amenity__icon {
    width: 28px;
    height: 28px;
    color: var(--grey-text);
  }

  .amenity__label {
    color: var(--charcoal);
    font-size: 0.875rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (min-width: 36rem) {
    .amenities__list {
      --cols: 4;
      --gap-x: 1.5rem;
    }
  }

  @media (min-width: 56rem) {
    .amenities__list {
      --cols: 6;
      --gap-x: 1.5rem;
    }
  }
</style>
