---
/** The large room photograph at the top of an accommodation page. Not revealed on scroll: it is the first thing seen. */
import Photo from '../Photo.astro';
import type { RoomPhoto } from '../../content/rooms';

interface Props {
  photo: RoomPhoto;
}
const { photo } = Astro.props;
---

<section class="room-hero" aria-label="Main photograph">
  <div class="container room-hero__frame">
    <Photo
      name={photo.key}
      alt={photo.alt}
      position={photo.position}
      ratio="16 / 9"
      sizes="(min-width: 90rem) 1344px, 100vw"
      widths={[640, 960, 1280, 1600, 2048]}
      loading="eager"
      fetchpriority="high"
      tone="dark"
      label="Junior Suite, main photograph"
    />
  </div>
</section>

<style>
  /* Phones: the photograph runs edge to edge. From 40rem it sits within the page margins, which keeps it from
     being enlarged past its own width on wide screens. */
  .room-hero {
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .room-hero__frame {
    padding-inline: 0;
  }

  .room-hero :global(.photo) {
    max-height: min(46rem, calc(100svh - var(--header-h)));
    aspect-ratio: 4 / 3 !important; /* a little taller on phones */
  }

  @media (min-width: 40rem) {
    .room-hero {
      padding-top: clamp(1rem, 2vw, 1.75rem);
    }

    .room-hero__frame {
      padding-inline: var(--gutter);
    }

    .room-hero :global(.photo) {
      aspect-ratio: 16 / 9 !important;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The same quiet settle as the homepage photograph. */
    .room-hero :global(.photo > img),
    .room-hero :global(.photo__placeholder) {
      animation: room-settle 2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes room-settle {
      from {
        transform: scale(1.04);
      }
      to {
        transform: scale(1);
      }
    }
  }
</style>
