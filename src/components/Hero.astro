---
import Photo from './Photo.astro';
import { hero } from '../content/home';
import { booking, contact } from '../config/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media">
      <Photo
        name={hero.photo}
        alt={hero.alt}
        position={hero.position}
        sizes="100vw"
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        loading="eager"
        fetchpriority="high"
        tone="dark"
        label="Hero photograph"
      />
    </div>

    <!-- A neutral black gradient only (no colour grade), so the headline reads and the photograph keeps its own light. -->
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="container">
        <div class="hero__text">
          <h1 id="hero-title">{hero.title}</h1>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__quay">
    <span class="waterline waterline--draw" aria-hidden="true"></span>
    <div class="container hero__quay-inner">
      <p>{contact.crossStreets}</p>
      <a class="btn" href={booking.url}>{booking.label}</a>
    </div>
  </div>
</section>

<style>
  /* Full-width, immersive photograph with the headline set directly on it. Phones: the headline sits at the foot,
     under the couple's faces. From 56rem: it sits on the left, over the sky, clear of the woman and the facade. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--white);
  }

  .hero__media {
    height: clamp(31rem, 84svh, 40rem);
    overflow: hidden;
  }

  /* Phone crop: the woman, her smile and the balconies stay in frame; the man's shoulder is left partly out. */
  .hero__media :global(.photo) {
    --focus: 66% 30% !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The one load moment: the photograph settles as the waterline is drawn. */
    .hero__media :global(.photo > img),
    .hero__media :global(.photo__placeholder) {
      animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.045);
      }
      to {
        transform: scale(1);
      }
    }
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.66) 0%,
      rgb(0 0 0 / 0.46) 26%,
      rgb(0 0 0 / 0.14) 52%,
      rgb(0 0 0 / 0) 70%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }

  .hero__overlay .container {
    padding-bottom: clamp(1.75rem, 6svh, 2.75rem);
  }

  .hero__text {
    position: relative;
    isolation: isolate;
  }

  .hero__text h1 {
    max-width: 11em;
    color: var(--white);
    font-weight: 300;
  }

  .hero__quay-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.1rem 1.25rem;
  }

  .hero__quay-inner p {
    color: var(--grey-text);
    font-size: var(--step--1);
  }

  @media (max-width: 39.99rem) {
    .hero__quay-inner p {
      display: none;
    }

    .hero__quay-inner .btn {
      width: 100%;
    }
  }

  @media (min-width: 56rem) {
    .hero__media {
      height: clamp(34rem, calc(100svh - var(--header-h)), 54rem);
    }

    .hero__media :global(.photo) {
      --focus: 60% 14% !important;
    }

    /* Left-hand gradient: strongest at the edge, gone before the woman (about 50% across). */
    .hero__shade {
      background: linear-gradient(
        90deg,
        rgb(0 0 0 / 0.3) 0%,
        rgb(0 0 0 / 0.2) 30%,
        rgb(0 0 0 / 0.06) 46%,
        rgb(0 0 0 / 0) 58%
      );
    }

    .hero__overlay {
      align-items: center;
    }

    /* A soft neutral cloud that travels with the headline, so contrast holds wherever the white shirt falls
       behind it, while the rest of the photograph keeps its own light. */
    .hero__text::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -2.5rem -4rem -2.5rem -16rem;
      pointer-events: none;
      background: rgb(0 0 0 / 0.46);
      filter: blur(3.25rem);
    }

    .hero__text h1 {
      text-shadow: 0 0 1.5rem rgb(0 0 0 / 0.25);
    }

    .hero__overlay .container {
      padding-bottom: 0;
    }
  }
</style>
