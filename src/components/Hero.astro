---
import Photo from './Photo.astro';
import { hero } from '../content/home';
import { booking, contact } from '../config/site';

// Keep place names and the hotel name together when the text wraps (display only; the content is unchanged).
const keepTogether = (t: string) => t.replace(/Phnom Penh/g, 'Phnom\u00a0Penh').replace(/Amanjaya Pancam/g, 'Amanjaya\u00a0Pancam');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media">
      <Photo
        name={hero.photo}
        alt={hero.alt}
        position={hero.position}
        sizes="100vw"
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        loading="eager"
        fetchpriority="high"
        tone="dark"
        label="Hero photograph"
      />
    </div>

    <!-- A neutral black gradient only (no colour grade), so the headline reads and the photograph keeps its own light. -->
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="container">
        <div class="hero__text">
          <h1 id="hero-title">{keepTogether(hero.title)}</h1>
          <p>{keepTogether(hero.support)}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__quay">
    <span class="waterline waterline--draw" aria-hidden="true"></span>
    <div class="container hero__quay-inner">
      <p>{contact.crossStreets}</p>
      <a class="btn" href={booking.url}>{booking.label}</a>
    </div>
  </div>
</section>

<style>
  /* Full-width, immersive photograph with the text set directly on it, as one block (headline, then a quieter line
     beneath it, both left-aligned on the same edge). Phones: the block sits at the foot, under the couple's faces.
     From 56rem: it sits on the right, above the woman and over the facade, so her face stays clear. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--white);
  }

  .hero__media {
    height: clamp(32rem, 86svh, 42rem);
    overflow: hidden;
  }

  /* Phone crop: the woman, her smile and the balconies stay in frame; the man's shoulder is left partly out. */
  .hero__media :global(.photo) {
    --focus: 66% 30% !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The one load moment: the photograph settles as the waterline is drawn. */
    .hero__media :global(.photo > img),
    .hero__media :global(.photo__placeholder) {
      animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.045);
      }
      to {
        transform: scale(1);
      }
    }
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.68) 0%,
      rgb(0 0 0 / 0.48) 28%,
      rgb(0 0 0 / 0.14) 54%,
      rgb(0 0 0 / 0) 72%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }

  .hero__overlay .container {
    padding-bottom: clamp(1.75rem, 6svh, 2.75rem);
  }

  .hero__text {
    position: relative;
    isolation: isolate;
    max-width: 24rem;
  }

  .hero__text h1 {
    max-width: none;
    color: var(--white);
    font-size: clamp(1.75rem, 1.35rem + 1.45vw, 2.5rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__text p {
    margin-top: 0.85rem;
    max-width: none;
    color: rgb(255 255 255 / 0.94);
    font-family: var(--font-heading);
    font-size: clamp(0.9375rem, 0.88rem + 0.25vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.005em;
    text-align: left;
    text-wrap: balance;
  }

  .hero__quay-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.1rem 1.25rem;
  }

  .hero__quay-inner p {
    color: var(--grey-text);
    font-size: var(--step--1);
  }

  @media (max-width: 39.99rem) {
    .hero__quay-inner p {
      display: none;
    }

    .hero__quay-inner .btn {
      width: 100%;
    }
  }

  @media (min-width: 56rem) {
    .hero__media {
      height: clamp(34rem, calc(100svh - var(--header-h)), 54rem);
    }

    .hero__media :global(.photo) {
      --focus: 60% 14% !important;
    }

    /* Right-hand gradient, gone before the woman (about 60% across). */
    .hero__shade {
      background: linear-gradient(
        270deg,
        rgb(0 0 0 / 0.34) 0%,
        rgb(0 0 0 / 0.22) 30%,
        rgb(0 0 0 / 0.07) 46%,
        rgb(0 0 0 / 0) 58%
      );
    }

    .hero__overlay {
      align-items: flex-start;
    }

    .hero__overlay .container {
      display: flex;
      justify-content: flex-end;
      padding-top: clamp(2.5rem, 13svh, 7rem);
      padding-bottom: 0;
    }

    .hero__text {
      width: 26rem;
      max-width: 100%;
    }

    /* A soft neutral shade that travels with the text block, so contrast holds against the pale facade while the
       rest of the photograph keeps its own light. */
    .hero__text::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -2.5rem -5rem -2.5rem -4rem;
      pointer-events: none;
      background: rgb(0 0 0 / 0.46);
      filter: blur(3.25rem);
    }

    .hero__text h1,
    .hero__text p {
      text-shadow: 0 0 1.25rem rgb(0 0 0 / 0.25);
    }
  }
</style>
