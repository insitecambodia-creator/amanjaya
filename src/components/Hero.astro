---
import Photo from './Photo.astro';
import { hero } from '../content/home';

// Keep place names and the hotel name together when the text wraps (display only; the content is unchanged).
const keepTogether = (t: string) => t.replace(/Phnom Penh/g, 'Phnom\u00a0Penh').replace(/Amanjaya Pancam/g, 'Amanjaya\u00a0Pancam');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" style={`--focus-m: ${hero.positionMobile}; --focus-d: ${hero.position}`}>
      <Photo
        name={hero.photo}
        alt={hero.alt}
        position={hero.position}
        sizes="(min-width: 56rem) 114vw, 100vw"
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        loading="eager"
        fetchpriority="high"
        tone="dark"
        label="Hero photograph"
      />
    </div>

    <!-- A neutral black gradient only (no colour grade), so the headline reads and the photograph keeps its own light. -->
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="container">
        <div class="hero__text">
          <h1 id="hero-title">{keepTogether(hero.title)}</h1>
          <p>{keepTogether(hero.support)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-width, immersive photograph with the text centred in its upper third, above the couple's faces. The
     headline and the quieter line beneath it are one block, centre-aligned. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--white);
  }

  .hero__media {
    height: clamp(32rem, 86svh, 42rem);
    overflow: hidden;
  }

  /* Phone crop: a window on the two faces (focal points are set in src/content/home.ts). */
  .hero__media :global(.photo) {
    --focus: var(--focus-m) !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The one load moment: the photograph settles. */
    .hero__media :global(.photo > img),
    .hero__media :global(.photo__placeholder) {
      animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.045);
      }
      to {
        transform: scale(1);
      }
    }
  }

  /* A discreet neutral gradient over the top of the photograph, behind the text. Black only, no colour grade. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.66) 0%,
      rgb(0 0 0 / 0.58) 20%,
      rgb(0 0 0 / 0.5) 34%,
      rgb(0 0 0 / 0.28) 48%,
      rgb(0 0 0 / 0.08) 60%,
      rgb(0 0 0 / 0) 70%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    pointer-events: none;
  }

  .hero__overlay .container {
    padding-top: clamp(1.75rem, 7svh, 4.5rem);
  }

  .hero__text {
    max-width: 26rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero__text h1 {
    max-width: none;
    color: var(--white);
    font-size: clamp(1.75rem, 1.35rem + 1.45vw, 2.5rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 0 1.25rem rgb(0 0 0 / 0.25);
  }

  .hero__text p {
    margin: 0.85rem auto 0;
    max-width: none;
    color: rgb(255 255 255 / 0.94);
    font-family: var(--font-heading);
    font-size: clamp(0.9375rem, 0.88rem + 0.25vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.005em;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 0 1.25rem rgb(0 0 0 / 0.25);
  }

  @media (min-width: 56rem) {
    .hero__media {
      height: clamp(34rem, calc(100svh - var(--header-h)), 54rem);
    }

    /* The photograph is enlarged about 14% and anchored to the right edge, which moves the man's raised phone left,
       out from behind the centred headline, and brings the couple nearer the middle. Both faces stay well inside. */
    .hero__media :global(.photo) {
      --focus: var(--focus-d) !important;
      width: 114%;
      margin-left: -14%;
    }
  }
</style>
