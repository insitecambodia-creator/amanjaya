---
import Photo from './Photo.astro';
import { hero } from '../content/home';

// Keep place names and the hotel name together when the text wraps (display only; the content is unchanged).
const keepTogether = (t: string) => t.replace(/Phnom Penh/g, 'Phnom\u00a0Penh').replace(/Amanjaya Pancam/g, 'Amanjaya\u00a0Pancam');

// The hotel's name in the supporting line is set in bronze (display only; the content is unchanged).
const [supportBefore, supportAfter = ''] = hero.support.split('Amanjaya Pancam');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" style={`--focus-m: ${hero.positionMobile}; --focus-d: ${hero.position}`}>
      <Photo
        name={hero.photo}
        alt={hero.alt}
        position={hero.position}
        sizes="(min-width: 56rem) 114vw, 100vw"
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        loading="eager"
        fetchpriority="high"
        tone="dark"
        label="Hero photograph"
      />
    </div>

    <!-- A neutral black gradient only (no colour grade), so the headline reads and the photograph keeps its own light. -->
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="container">
        <div class="hero__text">
          <h1 id="hero-title">{keepTogether(hero.title)}</h1>
          <p>{keepTogether(supportBefore)}<span class="hero__brand">Amanjaya&nbsp;Pancam</span>{keepTogether(supportAfter)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-width, immersive photograph with the text set directly on it as one left-aligned block (headline, then a
     quieter line beneath it). From 72rem it sits on the right, vertically centred, clear of the couple; below that,
     including phones, it sits at the foot of the photograph, under both faces. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--white);
  }

  .hero__media {
    height: clamp(32rem, 86svh, 42rem);
    overflow: hidden;
  }

  /* Phone crop: a window on the two faces (focal points are set in src/content/home.ts). */
  .hero__media :global(.photo) {
    --focus: var(--focus-m) !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The one load moment: the photograph settles. */
    .hero__media :global(.photo > img),
    .hero__media :global(.photo__placeholder) {
      animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.045);
      }
      to {
        transform: scale(1);
      }
    }
  }

  /* A discreet neutral gradient behind the text. Black only, no colour grade. Under 72rem it rises from the bottom. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.8) 0%,
      rgb(0 0 0 / 0.68) 18%,
      rgb(0 0 0 / 0.5) 32%,
      rgb(0 0 0 / 0.18) 54%,
      rgb(0 0 0 / 0) 72%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }

  .hero__overlay .container {
    padding-bottom: clamp(1.75rem, 6svh, 2.75rem);
  }

  .hero__text {
    max-width: 26rem;
  }

  .hero__text h1 {
    max-width: none;
    color: var(--white);
    font-size: clamp(1.75rem, 1.35rem + 1.45vw, 2.5rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 0 1.25rem rgb(0 0 0 / 0.25);
  }

  .hero__text p {
    margin: 0.85rem 0 0;
    max-width: none;
    color: rgb(255 255 255 / 0.94);
    font-family: var(--font-heading);
    font-size: clamp(0.9375rem, 0.88rem + 0.25vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.005em;
    text-align: left;
    text-wrap: balance;
    text-shadow: 0 0 1.25rem rgb(0 0 0 / 0.25);
  }

  /* The hotel's name in a light bronze, a little brighter than the site's usual accent on dark so it keeps 4.5:1 or
     better against the lightest parts of the photograph behind the panel and the bottom shade. */
  .hero__brand {
    color: #dfc392;
    font-weight: 600;
  }

  @media (min-width: 56rem) {
    .hero__media {
      height: clamp(34rem, calc(100svh - var(--header-h)), 54rem);
    }

    .hero__media :global(.photo) {
      --focus: var(--focus-d) !important;
    }
  }

  /* Wide screens: the block sits on the right, vertically centred, on a flat dark panel (65% black, small corners,
     no blur) clear of the couple. The panel keeps the sky and the palace as photographed; there is no vignette. */
  @media (min-width: 72rem) {
    .hero__shade {
      display: none;
    }

    .hero__overlay {
      align-items: center;
    }

    .hero__overlay .container {
      display: flex;
      justify-content: flex-end;
      padding-bottom: 0;
    }

    .hero__text {
      width: 29rem;
      max-width: 100%;
      padding: 2.6rem 2.75rem;
      background: rgb(0 0 0 / 0.65);
      border-radius: 4px;
    }

    .hero__text h1,
    .hero__text p {
      text-shadow: none;
    }
  }
</style>
