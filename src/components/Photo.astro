---
/**
 * Renders a local hotel photograph by key (the file name stem in src/assets/photos/, see src/data/image-manifest.json).
 * If the file is not there, a clearly labelled placeholder is drawn instead. Nothing is hotlinked.
 */
import { Image } from 'astro:assets';
import { findPhoto } from '../lib/photos';

interface Props {
  name: string;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** CSS aspect-ratio for the frame, e.g. "3 / 2". Omit to let the parent size the frame. */
  ratio?: string;
  /** Use the photograph's own proportions for the frame (no cropping). */
  natural?: boolean;
  /** Focal point for cropping, as CSS object-position, e.g. "60% 30%". */
  position?: string;
  /** Placeholder shade only. */
  tone?: 'light' | 'dark';
  /** Human description shown on the placeholder. */
  label?: string;
  class?: string;
}

const {
  name,
  alt,
  sizes,
  widths = [480, 800, 1200, 1600],
  loading = 'lazy',
  fetchpriority,
  ratio,
  natural = false,
  position,
  tone = 'light',
  label,
  class: className = '',
} = Astro.props;

const photo = findPhoto(name);
const frameRatio = ratio ?? (natural && photo ? `${photo.width} / ${photo.height}` : undefined);
const style = [frameRatio && `aspect-ratio:${frameRatio}`, position && `--focus:${position}`].filter(Boolean).join(';') || undefined;
---

<div class:list={['photo', className]} style={style}>
  {
    photo ? (
      <Image
        src={photo}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={loading === 'eager' ? 'sync' : 'async'}
        format="webp"
        quality={78}
      />
    ) : (
      <div class={`photo__placeholder photo__placeholder--${tone}`} data-photo-missing={name}>
        <p>
          <strong>Placeholder</strong>
          {label ?? alt}
          <small>Awaiting original photo: {name}</small>
        </p>
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: var(--grey-fill);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.1rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .photo__placeholder p {
    display: grid;
    gap: 0.15rem;
    max-width: 30ch;
  }

  .photo__placeholder strong {
    font-weight: 600;
  }

  .photo__placeholder small {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .photo__placeholder--light {
    background: #ebebeb;
    color: #4d4d4d;
  }

  .photo__placeholder--dark {
    background: #4d4d4d;
    color: #f2f2f2;
  }
</style>
