---
/**
 * Renders a local hotel photograph by key (the file name stem in src/assets/photos/, see src/data/image-manifest.json).
 * If the file has not been downloaded yet, a clearly labelled placeholder is drawn instead. Nothing is hotlinked.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** CSS aspect-ratio, e.g. "3 / 2". Omit to let the parent size the frame. */
  ratio?: string;
  /** Placeholder shade only. */
  tone?: 'light' | 'dark';
  /** Human description shown on the placeholder. */
  label?: string;
  class?: string;
}

const {
  name,
  alt,
  sizes,
  widths = [480, 800, 1200, 1600],
  loading = 'lazy',
  fetchpriority,
  ratio,
  tone = 'light',
  label,
  class: className = '',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const style = ratio ? `aspect-ratio:${ratio}` : undefined;
---

<div class:list={['photo', className]} style={style}>
  {
    match ? (
      <Image
        src={match[1].default}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={loading === 'eager' ? 'sync' : 'async'}
        format="webp"
        quality={78}
      />
    ) : (
      <div class={`photo__placeholder photo__placeholder--${tone}`} data-photo-missing={name}>
        <p>
          <strong>Placeholder</strong>
          {label ?? alt}
          <small>Awaiting original photo: {name}</small>
        </p>
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: var(--ivory-deep);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.1rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .photo__placeholder p {
    display: grid;
    gap: 0.15rem;
    max-width: 30ch;
  }

  .photo__placeholder strong {
    font-weight: 600;
  }

  .photo__placeholder small {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .photo__placeholder--light {
    background: #d9d1bd;
    color: #4b4a45;
  }

  .photo__placeholder--dark {
    background: #46524c;
    color: #ece6d6;
  }
</style>
