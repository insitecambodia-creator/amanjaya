---
import Photo from './Photo.astro';
import { suites } from '../content/home';
import { pricing, startingPrice } from '../data/pricing';
---

<section class="suites section" id="suites" aria-labelledby="suites-title">
  <div class="container">
    <header class="suites__head">
      <h2 id="suites-title">{suites.title}</h2>
      <p>{suites.intro}</p>
    </header>

    <ul class="rooms">
      {
        suites.items.map((room) => {
          const price = startingPrice(room.id);
          return (
            <li class="room">
              <figure class="room__photo">
                <Photo
                  name={room.photo}
                  alt={room.alt}
                  ratio="4 / 3"
                  position={room.position}
                  sizes="(min-width: 72rem) 22vw, (min-width: 40rem) 44vw, 92vw"
                  label={`${room.name} photograph`}
                />
              </figure>
              <div class="room__body">
                <h3>{room.name}</h3>
                <p class="room__note">{room.note}</p>
                <p class="room__summary">{room.summary}</p>
                <div class="room__foot">
                  {price && (
                    <p class="room__price">
                      <span class="room__from">{price.label}</span> <span class="room__amount">{price.amount}</span>
                    </p>
                  )}
                  <a class="btn btn--outline" href={room.exploreUrl}>
                    Explore<span class="sr-only"> {room.name}</span>
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="suites__note">{pricing.disclaimer}</p>
  </div>
</section>

<style>
  .suites__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .suites__head h2 {
    color: var(--teak);
  }

  .suites__head p {
    color: var(--grey-text);
  }

  /* One column on phones, two on tablets and small laptops, four from 72rem. */
  .rooms {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 4vw, 3rem) clamp(1.25rem, 2vw, 1.75rem);
  }

  .room {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
  }

  .room__photo {
    overflow: hidden;
  }

  .room__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.45rem;
    align-content: start;
  }

  .room__body h3 {
    color: var(--teak);
  }

  .room__note {
    color: var(--bronze-deep);
    font-size: var(--step--1);
  }

  .room__summary {
    margin-top: 0.35rem;
    max-width: 34ch;
  }

  /* The price row sits on a bronze hairline, a small echo of the waterline. */
  .room__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--bronze) 55%, transparent);
  }

  .room__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .room__from {
    color: var(--grey-text);
    font-size: var(--step--1);
  }

  .room__amount {
    color: var(--teak);
    font-family: var(--font-heading);
    font-size: var(--step-1);
  }

  .suites__note {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 70ch;
    color: var(--grey-text);
    font-size: var(--step--1);
  }

  @media (min-width: 40rem) {
    .rooms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .rooms {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
