---
import Photo from './Photo.astro';
import { gallery } from '../content/home';
import { findPhoto } from '../lib/photos';

/** Flex-grow equal to the photograph's proportions makes every photograph in a row the same height, uncropped. */
const grow = (name: string) => {
  const p = findPhoto(name);
  return p ? (p.width / p.height).toFixed(3) : '1.5';
};
---

<section class="gallery section" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title" data-reveal>{gallery.title}</h2>
    <div class="gallery__rows">
      {
        gallery.rows.map((row) => (
          <ul class="gallery__row">
            {row.map((g) => (
              <li style={`--grow:${grow(g.photo)}`} data-reveal>
                <Photo
                  name={g.photo}
                  alt={g.alt}
                  natural
                  sizes="(min-width: 56rem) 45vw, 92vw"
                  widths={[480, 800, 1200, 1600]}
                  label={g.alt}
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    <a class="gallery__all" href="/image-gallery-amanjaya/" data-reveal>View all photographs</a>
  </div>
</section>

<style>
  .gallery {
    padding-top: 0;
  }

  .gallery h2 {
    color: var(--teak);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .gallery__rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }

  .gallery__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }

  @media (min-width: 40rem) {
    .gallery__row {
      display: flex;
    }

    .gallery__row li {
      flex: var(--grow) 1 0%;
      min-width: 0;
    }
  }

  .gallery__all {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--bronze);
    color: var(--bronze-deep);
    font-size: var(--text-size);
    line-height: 1.6;
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .gallery__all:hover {
    color: var(--teak);
    border-color: var(--teak);
  }
</style>
