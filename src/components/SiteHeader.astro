---
import { site, nav, booking } from '../config/site';

interface Props {
  /** On pages other than the homepage, the homepage path ("/"): in-page links then lead back to its sections. */
  home?: string;
}
const { home = '' } = Astro.props;
---

<header class="header">
  <div class="header__bar container">
    <a class="wordmark" href={`${home}#top`} aria-label={`${site.name} ${site.descriptor}, ${home ? 'home' : 'back to top'}`}>
      <span class="wordmark__name">{site.name}</span>
      <span class="wordmark__place">{site.descriptor}</span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href.startsWith('/') ? item.href : `${home}${item.href}`} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a></li>)}
        <li class="nav__book"><a href={booking.url}>{booking.label}</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn" href={booking.url}>{booking.label}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__label">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu only. Without JavaScript the navigation simply stays visible.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      toggle.querySelector('.menu-toggle__label')!.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: var(--header-h);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-shrink: 0;
    white-space: nowrap;
    color: var(--teak);
    text-decoration: none;
  }

  .wordmark__name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .wordmark__place {
    line-height: 1.2;
    letter-spacing: 0;
    display: none;
    font-size: var(--step--1);
    color: var(--grey-text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__actions .btn {
    min-height: 2.5rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.75rem;
    letter-spacing: 0;
  }

  /* Very narrow phones (under 360px): the bar has no room for the button, so Book Your Stay moves into the menu. */
  .nav__book {
    display: none;
  }

  @media (max-width: 22.49rem) {
    .header__actions .btn {
      display: none;
    }

    .nav__book {
      display: block;
    }
  }

  .menu-toggle {
    display: none;
    min-height: 2.5rem;
    padding: 0 0.6rem;
    border: 1px solid color-mix(in srgb, var(--teak) 45%, transparent);
    background: transparent;
    color: var(--teak);
    font: inherit;
    line-height: 1.2;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
  }

  /* Small screens: navigation becomes a panel under the bar. */
  .nav {
    line-height: 1.65;
    position: absolute;
    inset: 100% 0 auto 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  :global(.js) .menu-toggle {
    display: inline-flex;
    align-items: center;
  }

  :global(.js) .nav:not(.is-open) {
    display: none;
  }

  .nav ul {
    display: grid;
  }

  .nav a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--charcoal);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--bronze-deep);
  }

  @media (min-width: 40rem) {
    .wordmark__name {
      font-size: 1.1875rem;
    }

    .menu-toggle {
      font-size: var(--step--1);
    }

    .header__actions .btn {
      padding: 0.5rem 1rem;
      font-size: var(--step--1);
      letter-spacing: 0.02em;
    }

    .menu-toggle {
      padding: 0 0.9rem;
    }
  }

  @media (min-width: 56rem) {
    .wordmark__place {
      display: inline;
    }

    .menu-toggle {
      display: none !important;
    }

    .nav,
    :global(.js) .nav:not(.is-open) {
      position: static;
      display: block;
      padding: 0;
      background: none;
      border: 0;
    }

    .nav ul {
      display: flex;
      gap: clamp(1rem, 2.6vw, 2.5rem);
    }

    .nav a {
      padding: 0.4rem 0;
      border: 0;
      font-family: var(--font-heading);
      font-size: var(--step--1);
      font-weight: 500;
      letter-spacing: 0.01em;
      background: linear-gradient(var(--bronze), var(--bronze)) 0 100% / 0 1px no-repeat;
      transition: background-size 0.25s ease;
    }

    .nav a:hover,
    .nav a:focus-visible {
      background-size: 100% 1px;
    }

    .header__actions .btn {
      min-height: 2.6rem;
      padding-inline: 1.4rem;
    }
  }
</style>
