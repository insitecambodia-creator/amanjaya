---
import Photo from './Photo.astro';
import { dining } from '../content/home';
---

<section class="dining section" id="dining" aria-labelledby="dining-title">
  <div class="container">
    <h2 id="dining-title" data-reveal>{dining.title}</h2>

    <div class="venues">
      {
        dining.venues.map((v, i) => (
          <article class:list={['venue', i % 2 === 1 && 'venue--reverse']}>
            <figure class="venue__photo" data-reveal>
              <Photo
                name={v.photo}
                alt={v.alt}
                ratio="3 / 2"
                position={v.position}
                sizes="(min-width: 56rem) 56vw, 92vw"
                widths={[640, 960, 1280, 1600]}
                label={`${v.name} photograph`}
              />
            </figure>
            <div class="venue__text" data-reveal>
              <h3>{v.name}</h3>
              <p class="venue__kind">{v.kind}</p>
              <p class="venue__desc">{v.text}</p>
              <a class="venue__link" href={v.link.url} rel="noopener">
                {v.link.label}
                <span class="sr-only"> (external website)</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dining h2 {
    color: var(--teak);
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .venues {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
  }

  /* Phones: the photograph above its text. */
  .venue {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .venue__text {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .venue__text h3 {
    color: var(--teak);
  }

  .venue__kind {
    color: var(--grey-text);
    font-size: var(--step--1);
  }

  .venue__desc {
    margin-top: 0.6rem;
    max-width: 38ch;
  }

  .venue__link {
    margin-top: 0.9rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--bronze);
    color: var(--bronze-deep);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .venue__link:hover {
    color: var(--teak);
    border-color: var(--teak);
  }

  /* From 56rem: the photograph takes 57% of the content width, alternating sides. */
  @media (min-width: 56rem) {
    .venue {
      grid-template-columns: minmax(0, 57%) minmax(0, 1fr);
      gap: clamp(2.5rem, 5.5vw, 5.5rem);
    }

    .venue--reverse {
      grid-template-columns: minmax(0, 1fr) minmax(0, 57%);
    }

    .venue--reverse .venue__photo {
      order: 2;
    }
  }
</style>
